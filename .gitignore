# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Runtime state
*.pid
*.log

# APKs (large binaries, don't commit)
apks/*.apk
apks/*.aab

# bundletool jar (download separately)
tools/*.jar

# Keep folders but not contents
!apks/.gitkeep
!rules/.gitkeep
!tools/.gitkeep
